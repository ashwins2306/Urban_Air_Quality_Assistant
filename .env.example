# ==============================================================================
# BreatheEasy Environment Configuration
# ==============================================================================

# (Optional) Google Gemini API Key for dynamic Generative AI advisory reasoning.
# If omitted or network is unreachable, BreatheEasy runs seamlessly on its built-in
# clean air clinical rule engine.
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) OpenAI API Key for GPT-4o-mini advisory reasoning.
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# FastAPI Host and Port
HOST=0.0.0.0
PORT=8000
